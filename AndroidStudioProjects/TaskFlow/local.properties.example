# Copy this file to  local.properties  (which is git-ignored) and fill in your key.
# Android Studio normally creates local.properties for you with the sdk.dir line;
# if so, just add the GROQ_API_KEY line to that existing file.

# Path to your Android SDK (Android Studio sets this automatically)
# sdk.dir=/Users/you/Library/Android/sdk

# Your Groq API key — get a FREE one at https://console.groq.com  → API Keys
# This is baked into the APK at build time and is NEVER committed to git.
GROQ_API_KEY=gsk_your_new_key_here
